# Virtual environment
venv/
env/
ENV/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Database files
*.db
*.sqlite
*.sqlite3
.env

# Database directory - ignore data files but allow schema files
database/*.db
database/*.sqlite
database/*.sqlite3
# Allow schema files to be tracked
!database/*.sql
!database/*.md
!database/*.js
!database/migrations/

# Log files
*.log
nohup.out

# Backup files
*.tar.gz
*.zip
*.bak

# Model files (except trained models)
# *.pkl
# *.model
# *.h5

# Allow trained models in data directory
!data/models/*.pkl
!data/models/*.model
!data/models/*.h5

# Git
.git/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# 보안 파일들 (절대 Git에 커밋하지 마세요!)
.env
.env.local
.env.production
.env.staging
*.token
*.key
*.pem
github_token.txt
credentials.txt
secrets.txt
node_modules/
# database/ is now partially ignored (only .db files)
*.log

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Audio data files (too large for git)
data/labeling_ready/*.wav
data/labeling_ready/*.mp3
data/audio/*.wav
data/audio/*.mp3