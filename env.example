# SmartCompressor AI System - Environment Variables
# 이 파일을 .env로 복사하고 실제 값으로 채워주세요
# cp env.example .env

# Flask 설정
FLASK_SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=production
FLASK_APP=app.py

# 데이터베이스 설정
DATABASE_URL=sqlite:///smartcompressor.db
# PostgreSQL 사용 시:
# DATABASE_URL=postgresql://user:password@localhost:5432/smartcompressor

# Sentry (선택사항)
SENTRY_DSN=

# 애플리케이션 버전
APP_VERSION=2.0.0

# 서버 설정
HOST=0.0.0.0
PORT=5000

# CORS 설정
ALLOWED_ORIGINS=https://signalcraft.kr,https://www.signalcraft.kr

# AI 모델 설정
MODELS_DIR=data/models
FEATURES_DIR=data/features

# 데이터 저장 설정
DATA_DIR=data
UPLOAD_DIR=uploads

# 로깅 레벨
LOG_LEVEL=INFO

